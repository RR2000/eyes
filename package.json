{
  "name": "eyes",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer eyes that follow the pointer, over a WebSocket. Avoid the ball.",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
